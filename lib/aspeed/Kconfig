config ASPEED_FMC_HEADER
	bool "Enable ASPEED FMC header lib"
	help
	  Support ASPEED proprietary boot FMC header lib

config ASPEED_CPTRA
	bool "Use Caliptra Library"
        help
          This enables the Caliptra common library to communicate with BootMCU
          via IPC in AST27xx SoC series.

config ASPEED_OTP_IPC
	bool "Use BootMCU OTP IPC Library"
	help
	  This enables reading and programming BootMCU OTP over a standalone
	  IPC channel in AST27xx SoC series, independent of the Caliptra IPC
	  library.
