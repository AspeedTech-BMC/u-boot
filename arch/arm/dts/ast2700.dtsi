			compatible = "aspeed,ast2700-pcie";
			device_type = "pci";
			reg = <0x0 0x140d0000 0x0 0x100>;
			linux,pci-domain = <2>;
			#address-cells = <3>;
			#size-cells = <2>;
			bus-range = <0x00 0xff>;

			ranges = <0x02000000 0 0xa0000000 0x0 0xa0000000 0x0 0x10000000>;

			status = "disabled";

			resets = <&soc1_rst SCU1_RESET_H2X>;
			reset-names = "h2x";

			aspeed,pciecfg = <&pcie_cfg2>;

			pcie@0,0 {
				compatible = "pciclass,0604";
				reg = <0 0 0 0 0>;
				#address-cells = <3>;
				#size-cells = <2>;
				device_type = "pci";
				clocks = <&soc1_clk SCU1_CLK_GATE_PCICLK>;
