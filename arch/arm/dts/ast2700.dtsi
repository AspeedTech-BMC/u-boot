			ranges = <0 0 0 0x14c02000 0 0x1000>;
			#address-cells = <2>;
			#size-cells = <2>;

			soc1_rst: reset-controller@14c02200 {
				compatible = "aspeed,ast2700-reset";
				reg = <0 0x200 0 0x40>;
				#reset-cells = <1>;
