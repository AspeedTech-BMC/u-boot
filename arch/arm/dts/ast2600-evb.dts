/dts-v1/;

#include "ast2600-u-boot.dtsi"

/ {
	model = "AST2600 EVB";
	compatible = "aspeed,ast2600-evb", "aspeed,ast2600";

	memory {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	chosen {
		stdout-path = &uart5;
	};

	aliases {
		mmc0 = &emmc_slot0;
		mmc1 = &sdhci_slot0;
		mmc2 = &sdhci_slot1;
		spi0 = &fmc;
		spi1 = &spi1;
		spi2 = &spi2;
		ethernet0 = &mac0;
		ethernet1 = &mac1;
		ethernet2 = &mac2;
		ethernet3 = &mac3;
	};

	cpus {
		cpu@0 {
			clock-frequency = <800000000>;
		};
		cpu@1 {
			clock-frequency = <800000000>;
		};
	};

	/*
	 * reserved-memory layout
	 * 0xb100_0000 ~ 0xb100_FFFF is reserved for mctp0 controller in linux side.
	 * 0xb101_0000 ~ 0xb101_FFFF is reserved for mctp1 controller in linux side.
	 */
	reserved-memory {
		mctp0_reserved: mctp0_reserved@b1000000 {
			reg = <0xb1000000 0x10000>;
			no-map;
		};

		mctp1_reserved: mctp1_reserved@b1010000 {
			reg = <0xb1010000 0x10000>;
			no-map;
		};
	};
};

&uart5 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&sdrammc {
	clock-frequency = <400000000>;
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&wdt3 {
	status = "okay";
};

&mdio {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <	&pinctrl_mdio1_default &pinctrl_mdio2_default
			&pinctrl_mdio3_default &pinctrl_mdio4_default>;
	#address-cells = <1>;
	#size-cells = <0>;
	ethphy0: ethernet-phy@0 {
		reg = <0>;
	};

	ethphy1: ethernet-phy@1 {
		reg = <0>;
	};

	ethphy2: ethernet-phy@2 {
		reg = <0>;
	};

	ethphy3: ethernet-phy@3 {
		reg = <0>;
	};
};

&mac0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii1_default>;
	rx-internal-delay-ps = <0>;
	tx-internal-delay-ps = <0>;
};

&mac1 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii2_default>;
	rx-internal-delay-ps = <0>;
	tx-internal-delay-ps = <0>;
};

&mac2 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii3_default>;
	rx-internal-delay-ps = <0>;
	tx-internal-delay-ps = <0>;
};

&mac3 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy3>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii4_default>;
	rx-internal-delay-ps = <0>;
	tx-internal-delay-ps = <0>;
};

&fmc {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fmcquad_default>;

	flash@0 {
		status = "okay";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@1 {
		status = "okay";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@2 {
		status = "disabled";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&spi1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi1_default &pinctrl_spi1abr_default
			&pinctrl_spi1cs1_default &pinctrl_spi1wp_default
			&pinctrl_spi1wp_default &pinctrl_spi1quad_default>;

	flash@0 {
		status = "okay";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@1 {
		status = "disabled";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&spi2 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi2_default &pinctrl_spi2cs1_default
			&pinctrl_spi2cs2_default &pinctrl_spi2quad_default>;

	flash@0 {
		status = "okay";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@1 {
		status = "disabled";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@2 {
		status = "disabled";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&emmc {
	u-boot,dm-pre-reloc;
	sdhci_hs200;
};

&emmc_slot0 {
	u-boot,dm-pre-reloc;
	status = "okay";
	bus-width = <4>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_emmc_default>;
	sdhci-drive-type = <1>;
	max-frequency = <200000000>;
};

&sdhci {
	status = "okay";
	sdhci_hs200;

	vcc_sdio0: vcc-sdio0 {
		status = "okay";
		compatible = "regulator-fixed";
		gpio = <&gpio0 ASPEED_GPIO(V, 0) GPIO_ACTIVE_HIGH>;
		regulator-name = "vcc_sdio0";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		regulator-boot-on;
	};

	vccq_sdio0: vccq-sdio0 {
		status = "okay";
		compatible = "regulator-gpio";
		gpios = <&gpio0 ASPEED_GPIO(V, 1) GPIO_ACTIVE_HIGH>;
		gpios-states = <1>;
		states = <1800000 0x0>,
			 <3300000 0x1>;
		regulator-name = "vccq_sdio0";
		regulator-type = "voltage";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vcc_sdio1: vcc-sdio1 {
		status = "okay";
		compatible = "regulator-fixed";
		gpio = <&gpio0 ASPEED_GPIO(V, 2) GPIO_ACTIVE_HIGH>;
		regulator-name = "vcc_sdio1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		regulator-boot-on;
	};

	vccq_sdio1: vccq-sdio1 {
		status = "okay";
		compatible = "regulator-gpio";
		gpios = <&gpio0 ASPEED_GPIO(V, 3) GPIO_ACTIVE_HIGH>;
		gpios-states = <1>;
		states = <1800000 0x0>,
			 <3300000 0x1>;
		regulator-name = "vccq_sdio1";
		regulator-type = "voltage";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&sdhci_slot0 {
	status = "okay";
	bus-width = <4>;
	vmmc-supply = <&vcc_sdio0>;
	vqmmc-supply = <&vccq_sdio0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sd1_default>;
	sdhci-drive-type = <3>;
	max-frequency = <100000000>;
};

&sdhci_slot1 {
	status = "okay";
	bus-width = <4>;
	vmmc-supply = <&vcc_sdio1>;
	vqmmc-supply = <&vccq_sdio1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sd2_default>;
	sdhci-drive-type = <3>;
	max-frequency = <100000000>;
};

&i2c4 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c5_default>;
};

&i2c5 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c6_default>;
};

&i2c6 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c7_default>;
};

&i2c7 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c8_default>;
};

&i2c8 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c9_default>;
};

&pcie_phy1 {
	status = "okay";
};

&pcie_bridge {
	status = "okay";
};

#if 0
&fsim0 {
	status = "okay";
};

&fsim1 {
	status = "okay";
};
#endif

#if 0
&vhub {
	status = "okay";
};
#endif

&ehci1 {
	status = "okay";
};

&display_port {
	status = "okay";
};

&hace {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&acry {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&sgpiom0 {
	status = "okay";
	ngpios = <128>;
};

&sgpiom1 {
	status = "okay";
	ngpios = <80>;
};
